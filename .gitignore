# Secrets and local config
.env
.env.*
!.env.example

# Go build output
/bin/
/dist/
*.exe
*.test
*.out
coverage.*
*.prof

# Go workspace files
go.work
go.work.sum

# Local databases (SQLite)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/data/

# Frontend (web/)
node_modules/

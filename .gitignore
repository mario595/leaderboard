# compiling before the first build.
/internal/spa/dist/*
!/internal/spa/dist/.gitkeep
*.tsbuildinfo
npm-debug.log*

# Editors and OS
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.DS_Store

# Debugger binaries
__debug_bin*
